{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(bash scripts/ci/lint.sh)",
      "Bash(bash scripts/ci/test.sh)",
      "Bash(bash scripts/ci/test.sh *)",
      "Bash(bash scripts/ci/build.sh)",
      "Bash(bash scripts/ci/audit.sh)",
      "Bash(bash scripts/trace-check.sh)",
      "Bash(bash scripts/trace-check.sh *)",
      "Bash(bash scripts/new-doc.sh *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(bash scripts/audit-main.sh)",
      "Bash(bash scripts/audit-main.sh *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh variable set *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.development)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(npm publish *)",
      "Bash(sudo *)",
      "Bash(bash scripts/merge-local.sh *)",
      "Bash(bash scripts/merge-local.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-sensitive-paths.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-format.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
